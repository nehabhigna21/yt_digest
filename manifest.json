{
  "manifest_version": 3,
  "name": "YT Digest",
  "version": "0.1.0",
  "description": "Get the full context of a YouTube video from its transcript.",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["page.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
